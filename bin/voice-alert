#!/bin/bash
# voice-alert — macOS 语音提醒（DSH / Claude Code / Codex 共用）
# 由 dsh-plugin-voice-alert 插件安装到 ~/.dsh/bin/，直接改这里会在下次 DSH 启动时被覆盖。
set -uo pipefail

STATE="$HOME/.dsh/state/voice-alert"
LOCK="$STATE/lock"
LOG="$STATE/log.tsv"
STOP="$STATE/stop"
WATCH_FILE="$STATE/watch"
VOICE_CACHE="$STATE/voice"
# 设置：DSH「设置 → 语音」写 config.env，三个 AI 工具共用；环境变量 VA_* 优先
CFG_FILE="$STATE/config.env"
[ -f "$CFG_FILE" ] && . "$CFG_FILE"
DEFAULT_VOICE="${VA_SAY_VOICE:-${VA_CFG_SAY_VOICE:-}}"
# 语音引擎：deepseek（云端 TTS，默认女声 stella）或 say（macOS 本地）
ENGINE="${VA_ENGINE:-${VA_CFG_ENGINE:-deepseek}}"
VOICE_ID="${VA_VOICE_ID:-${VA_CFG_VOICE_ID:-stella}}"
VLANG="${VA_LANG:-${VA_CFG_LANG:-zh}}"
DEDUPE="${VA_DEDUPE:-${VA_CFG_DEDUPE:-20}}"
APPROVAL_ON="${VA_CFG_APPROVAL:-1}"
# 云端合成：插件写进 config.env 的 node + va-tts.mjs
NODE_BIN="${VA_CFG_NODE:-$(command -v node 2>/dev/null)}"
TTS_JS="${VA_CFG_TTS:-}"
# 鉴权：account = DSH 已登录的 DeepSeek 账号（插件同步 token），api-key = 自定义 key
# 语音合成服务商：official = DeepSeek 官方（只要 key）；custom = 第三方兼容服务（base URL + key）
PROVIDER="${VA_CFG_PROVIDER:-official}"
BASE_URL="${VA_CFG_BASE_URL:-}"
if [ "$PROVIDER" = "custom" ]; then KEY_FILE="$HOME/.dsh/secrets/voice-alert-custom.key"
else KEY_FILE="$HOME/.dsh/secrets/deepseek.key"; fi
CACHE="$STATE/cache"
SOUNDS="/System/Library/Sounds"
STARTED=$(date +%s)
VERSION="1.2.0"
# 谁在喊：dsh | claude | codex（开头先报来源，三个 AI 工具共用这一个脚本）
SOURCE="${VA_SOURCE:-dsh}"
PROJECT="${VA_PROJECT:-}"

source_label() {
  case "$SOURCE" in
    claude|claude-code) echo "Claude Code" ;;
    codex) echo "Codex" ;;
    dsh|deepseek*) echo "DSH" ;;
    *) echo "$SOURCE" ;;
  esac
}

# 播报用语：VLANG = zh en ja ko fr de es pt it ru；未知语言按 en
m() {
  case "$VLANG:$1" in
    zh:need_code) printf %s '，需要验证码。' ;;
    zh:code_is) printf %s '验证码是，' ;;
    zh:again) printf %s '再说一遍，' ;;
    zh:send_code) printf %s '请把验证码发给我。' ;;
    zh:done) printf %s '，完成了。' ;;
    zh:approve) printf %s '，需要你批准。' ;;
    zh:sep) printf %s '：' ;;
    zh:please_check) printf %s '请回来看一下。' ;;
    zh:t_code) printf %s '需要验证码' ;;
    zh:t_done) printf %s '任务完成' ;;
    zh:t_approve) printf %s '需要你批准' ;;
    zh:t_urgent) printf %s '需要你处理' ;;
    zh:t_other) printf %s '提醒' ;;
    en:need_code) printf %s ' needs a verification code.' ;;
    en:code_is) printf %s 'The code is, ' ;;
    en:again) printf %s 'Once more, ' ;;
    en:send_code) printf %s 'Please send me the code.' ;;
    en:done) printf %s ' is done. ' ;;
    en:approve) printf %s ' needs your approval. ' ;;
    en:sep) printf %s ': ' ;;
    en:please_check) printf %s 'Please come back and check.' ;;
    en:t_code) printf %s 'Verification code' ;;
    en:t_done) printf %s 'Task done' ;;
    en:t_approve) printf %s 'Needs your approval' ;;
    en:t_urgent) printf %s 'Needs your attention' ;;
    en:t_other) printf %s 'Alert' ;;
    ja:need_code) printf %s '、確認コードが必要です。' ;;
    ja:code_is) printf %s 'コードは、' ;;
    ja:again) printf %s 'もう一度、' ;;
    ja:send_code) printf %s 'コードを送ってください。' ;;
    ja:done) printf %s '、完了しました。' ;;
    ja:approve) printf %s '、承認が必要です。' ;;
    ja:sep) printf %s '：' ;;
    ja:please_check) printf %s '確認しに戻ってください。' ;;
    ja:t_code) printf %s '確認コード' ;;
    ja:t_done) printf %s '完了' ;;
    ja:t_approve) printf %s '承認が必要' ;;
    ja:t_urgent) printf %s '対応が必要' ;;
    ja:t_other) printf %s '通知' ;;
    ko:need_code) printf %s ' 인증 코드가 필요합니다.' ;;
    ko:code_is) printf %s '코드는, ' ;;
    ko:again) printf %s '다시 한 번, ' ;;
    ko:send_code) printf %s '코드를 보내 주세요.' ;;
    ko:done) printf %s ' 작업이 끝났습니다. ' ;;
    ko:approve) printf %s ' 승인이 필요합니다. ' ;;
    ko:sep) printf %s ': ' ;;
    ko:please_check) printf %s '돌아와서 확인해 주세요.' ;;
    ko:t_code) printf %s '인증 코드' ;;
    ko:t_done) printf %s '작업 완료' ;;
    ko:t_approve) printf %s '승인 필요' ;;
    ko:t_urgent) printf %s '확인 필요' ;;
    ko:t_other) printf %s '알림' ;;
    fr:need_code) printf %s ' : un code de vérification est nécessaire.' ;;
    fr:code_is) printf %s 'Le code est, ' ;;
    fr:again) printf %s 'Je répète, ' ;;
    fr:send_code) printf %s 'Merci de m'\''envoyer le code.' ;;
    fr:done) printf %s ' : c’est terminé. ' ;;
    fr:approve) printf %s ' : votre approbation est nécessaire. ' ;;
    fr:sep) printf %s ' : ' ;;
    fr:please_check) printf %s 'Revenez vérifier, s’il vous plaît.' ;;
    fr:t_code) printf %s 'Code de vérification' ;;
    fr:t_done) printf %s 'Tâche terminée' ;;
    fr:t_approve) printf %s 'Approbation requise' ;;
    fr:t_urgent) printf %s 'Action requise' ;;
    fr:t_other) printf %s 'Alerte' ;;
    de:need_code) printf %s ': Ein Bestätigungscode wird benötigt.' ;;
    de:code_is) printf %s 'Der Code lautet, ' ;;
    de:again) printf %s 'Noch einmal, ' ;;
    de:send_code) printf %s 'Bitte schick mir den Code.' ;;
    de:done) printf %s ': Fertig. ' ;;
    de:approve) printf %s ': Deine Freigabe wird benötigt. ' ;;
    de:sep) printf %s ': ' ;;
    de:please_check) printf %s 'Bitte komm zurück und sieh nach.' ;;
    de:t_code) printf %s 'Bestätigungscode' ;;
    de:t_done) printf %s 'Aufgabe fertig' ;;
    de:t_approve) printf %s 'Freigabe nötig' ;;
    de:t_urgent) printf %s 'Aktion nötig' ;;
    de:t_other) printf %s 'Hinweis' ;;
    es:need_code) printf %s ': se necesita un código de verificación.' ;;
    es:code_is) printf %s 'El código es, ' ;;
    es:again) printf %s 'Otra vez, ' ;;
    es:send_code) printf %s 'Envíame el código, por favor.' ;;
    es:done) printf %s ': terminado. ' ;;
    es:approve) printf %s ': se necesita tu aprobación. ' ;;
    es:sep) printf %s ': ' ;;
    es:please_check) printf %s 'Vuelve a revisar, por favor.' ;;
    es:t_code) printf %s 'Código de verificación' ;;
    es:t_done) printf %s 'Tarea terminada' ;;
    es:t_approve) printf %s 'Necesita aprobación' ;;
    es:t_urgent) printf %s 'Necesita atención' ;;
    es:t_other) printf %s 'Aviso' ;;
    pt:need_code) printf %s ': é preciso um código de verificação.' ;;
    pt:code_is) printf %s 'O código é, ' ;;
    pt:again) printf %s 'Mais uma vez, ' ;;
    pt:send_code) printf %s 'Por favor, me envie o código.' ;;
    pt:done) printf %s ': concluído. ' ;;
    pt:approve) printf %s ': é preciso sua aprovação. ' ;;
    pt:sep) printf %s ': ' ;;
    pt:please_check) printf %s 'Por favor, volte para verificar.' ;;
    pt:t_code) printf %s 'Código de verificação' ;;
    pt:t_done) printf %s 'Tarefa concluída' ;;
    pt:t_approve) printf %s 'Precisa de aprovação' ;;
    pt:t_urgent) printf %s 'Precisa de atenção' ;;
    pt:t_other) printf %s 'Alerta' ;;
    it:need_code) printf %s ': serve un codice di verifica.' ;;
    it:code_is) printf %s 'Il codice è, ' ;;
    it:again) printf %s 'Ripeto, ' ;;
    it:send_code) printf %s 'Mandami il codice, per favore.' ;;
    it:done) printf %s ': finito. ' ;;
    it:approve) printf %s ': serve la tua approvazione. ' ;;
    it:sep) printf %s ': ' ;;
    it:please_check) printf %s 'Torna a controllare, per favore.' ;;
    it:t_code) printf %s 'Codice di verifica' ;;
    it:t_done) printf %s 'Attività completata' ;;
    it:t_approve) printf %s 'Serve approvazione' ;;
    it:t_urgent) printf %s 'Serve attenzione' ;;
    it:t_other) printf %s 'Avviso' ;;
    ru:need_code) printf %s ': нужен код подтверждения.' ;;
    ru:code_is) printf %s 'Код: ' ;;
    ru:again) printf %s 'Ещё раз: ' ;;
    ru:send_code) printf %s 'Пришлите мне код, пожалуйста.' ;;
    ru:done) printf %s ': готово. ' ;;
    ru:approve) printf %s ': нужно ваше одобрение. ' ;;
    ru:sep) printf %s ': ' ;;
    ru:please_check) printf %s 'Вернитесь и проверьте, пожалуйста.' ;;
    ru:t_code) printf %s 'Код подтверждения' ;;
    ru:t_done) printf %s 'Задача выполнена' ;;
    ru:t_approve) printf %s 'Нужно одобрение' ;;
    ru:t_urgent) printf %s 'Нужно ваше внимание' ;;
    ru:t_other) printf %s 'Уведомление' ;;
    *) [ "$VLANG" != "en" ] && VLANG=en m "$1" ;;
  esac
}

# 播报开头：「来自 Claude Code，某某项目」/「From Claude Code, project X」…
lead() {
  local x; x="$(source_label)"
  case "$VLANG" in
    zh) printf %s '来自 '"$x"''; [ -n "$PROJECT" ] && printf %s '，'"$PROJECT"' 项目' ;;
    en) printf %s 'From '"$x"''; [ -n "$PROJECT" ] && printf %s ', project '"$PROJECT"'' ;;
    ja) printf %s ''"$x"' から'; [ -n "$PROJECT" ] && printf %s '、'"$PROJECT"' プロジェクト' ;;
    ko) printf %s ''"$x"'에서'; [ -n "$PROJECT" ] && printf %s ', '"$PROJECT"' 프로젝트' ;;
    fr) printf %s 'De '"$x"''; [ -n "$PROJECT" ] && printf %s ', projet '"$PROJECT"'' ;;
    de) printf %s 'Von '"$x"''; [ -n "$PROJECT" ] && printf %s ', Projekt '"$PROJECT"'' ;;
    es) printf %s 'De '"$x"''; [ -n "$PROJECT" ] && printf %s ', proyecto '"$PROJECT"'' ;;
    pt) printf %s 'De '"$x"''; [ -n "$PROJECT" ] && printf %s ', projeto '"$PROJECT"'' ;;
    it) printf %s 'Da '"$x"''; [ -n "$PROJECT" ] && printf %s ', progetto '"$PROJECT"'' ;;
    ru) printf %s 'От '"$x"''; [ -n "$PROJECT" ] && printf %s ', проект '"$PROJECT"'' ;;
    *) VLANG=en lead ;;
  esac
}

# 通知条副标题
proj_label() {
  case "$VLANG" in
    zh) printf %s ''"$PROJECT"' 项目' ;;
    en) printf %s 'Project '"$PROJECT"'' ;;
    ja) printf %s ''"$PROJECT"' プロジェクト' ;;
    ko) printf %s ''"$PROJECT"' 프로젝트' ;;
    fr) printf %s 'Projet '"$PROJECT"'' ;;
    de) printf %s 'Projekt '"$PROJECT"'' ;;
    es) printf %s 'Proyecto '"$PROJECT"'' ;;
    pt) printf %s 'Projeto '"$PROJECT"'' ;;
    it) printf %s 'Progetto '"$PROJECT"'' ;;
    ru) printf %s 'Проект '"$PROJECT"'' ;;
    *) printf %s "Project $PROJECT" ;;
  esac
}

mkdir -p "$STATE" "$CACHE"

probe_voice() {
  [ -z "${1:-}" ] && return 1
  local tmp
  tmp=$(mktemp -t va) || return 1
  if say -v "$1" -o "$tmp" "a" >/dev/null 2>&1; then rm -f "$tmp"; return 0; fi
  rm -f "$tmp"; return 1
}

detect_voice() {
  local c=""
  [ -f "$VOICE_CACHE" ] && c=$(cat "$VOICE_CACHE" 2>/dev/null)
  if [ -n "$c" ] && probe_voice "$c"; then printf '%s' "$c"; return; fi
  local v
  for v in "Tingting" "Meijia" "Sinji" "Eddy (Chinese (China mainland))" "Flo (Chinese (China mainland))" "Sandy (Chinese (China mainland))" "Shelley (Chinese (China mainland))" "Grandma (Chinese (China mainland))"; do
    if probe_voice "$v"; then printf '%s' "$v" > "$VOICE_CACHE"; printf '%s' "$v"; return; fi
  done
  : > "$VOICE_CACHE"
}

voice_label() {
  if [ -n "${1:-}" ]; then echo "$1"; else echo "系统默认"; fi
}

ts()  { date '+%F %T'; }
log() { printf '%s\t%s\n' "$(ts)" "$*" >> "$LOG"; }

usage() {
  cat <<'USAGEEOF'
voice-alert — 用语音 + 通知条提醒用户（macOS）

  voice-alert [选项] "要说的内容"
  voice-alert --code 834291        验证码：逐位慢读并重复
  voice-alert stop | status | doctor
  voice-alert watch on|off          待命模式：开启后长任务也会出声

选项:
  --from dsh|claude|codex   来源，开头会念「来自 X」（默认 $VA_SOURCE 或 dsh）
  --project 名字    项目名，念成「某某项目……」（默认 $VA_PROJECT）
  --style done|progress|code|approve|urgent|plain|raw   预设语气（默认 progress；raw=原样朗读，不加来源）
  --approve "事项"  等你批准（= --style approve）
  --voice stella|tide   DeepSeek 音色（默认 stella 女声）；传 macOS 音色名则走本地 say
  --engine deepseek|say 语音引擎（默认 deepseek；失败/离线自动退回 say）
  --rate N          语速（仅 say 引擎有效，默认 185）
  --repeat N        重复次数（默认 1；urgent=2，code=2）
  --interval SEC    重复间隔秒数（默认 20）
  --no-chime        不加提示音
  --no-banner       不弹通知条
  --keep-volume     不改系统音量/静音状态
  --wait            前台播放并等待结束（默认后台，立即返回）
USAGEEOF
}

SAVED_MUTED=""; SAVED_VOL=""; TOUCHED=0

prepare_audio() {
  [ "${KEEP_VOLUME:-0}" = "1" ] && return 0
  SAVED_MUTED=$(osascript -e 'output muted of (get volume settings)' 2>/dev/null)
  SAVED_VOL=$(osascript -e 'output volume of (get volume settings)' 2>/dev/null)
  case "$SAVED_MUTED" in true) osascript -e 'set volume without output muted' >/dev/null 2>&1; TOUCHED=1;; esac
  if [ -n "$SAVED_VOL" ] && [ "$SAVED_VOL" -lt 45 ] 2>/dev/null; then
    osascript -e 'set volume output volume 60' >/dev/null 2>&1; TOUCHED=1
  fi
}

restore_audio() {
  [ "$TOUCHED" = "1" ] || return 0
  [ -n "$SAVED_VOL" ] && osascript -e "set volume output volume $SAVED_VOL" >/dev/null 2>&1
  [ "$SAVED_MUTED" = "true" ] && osascript -e 'set volume with output muted' >/dev/null 2>&1
  TOUCHED=0
}

acquire_lock() {
  local waited=0
  while ! mkdir "$LOCK" 2>/dev/null; do
    if [ -d "$LOCK" ]; then
      local mtime age
      mtime=$(stat -f %m "$LOCK" 2>/dev/null || echo 0)
      age=$(( $(date +%s) - mtime ))
      # 持锁进程已经死了 → 立刻清掉陈旧锁，否则后来者会干等三分钟再补播一堆
      lp=$(cat "$LOCK/pid" 2>/dev/null || echo "")
      if [ -n "$lp" ] && ! kill -0 "$lp" 2>/dev/null; then
        rm -rf "$LOCK" 2>/dev/null; continue
      fi
      if [ "$age" -gt 120 ]; then rm -rf "$LOCK" 2>/dev/null; continue; fi
    fi
    sleep 0.2; waited=$((waited+1))
    [ "$waited" -ge 900 ] && return 0
  done
  echo $$ > "$LOCK/pid" 2>/dev/null
}
release_lock() { rm -rf "$LOCK" 2>/dev/null; }

chime() { [ -f "$SOUNDS/$1.aiff" ] && afplay -v 1.2 "$SOUNDS/$1.aiff" 2>/dev/null; }

has_key() {
  if [ "$PROVIDER" = "custom" ]; then [ -n "$BASE_URL" ] && [ -s "$KEY_FILE" ]
  else [ -s "$KEY_FILE" ] || [ -s "$STATE/dsh-deepseek.key" ]; fi
}

# 缓存只留最近 60 条，重复的「完成了」不用每次重新合成
trim_cache() {
  ls -t "$CACHE" 2>/dev/null | tail -n +61 | while read -r f; do rm -f "$CACHE/$f"; done
}

can_cloud() { [ -n "$TTS_JS" ] && [ -f "$TTS_JS" ] && [ -x "$NODE_BIN" ]; }
tts_to() { printf '%s' "$1" | "$NODE_BIN" "$TTS_JS" "$VOICE_ID" "$2" "$PROVIDER" "$BASE_URL" >/dev/null 2>&1; }

# 合成一句到缓存，成功时打印文件路径
synth_file() {
  local text="$1" h out part
  h=$(printf '%s|%s' "$VOICE_ID" "$text" | md5 -q 2>/dev/null) || return 1
  out="$CACHE/$h.wav"
  if [ -s "$out" ]; then printf '%s\n' "$out"; return 0; fi
  part="$out.part.$$"
  if tts_to "$text" "$part" && [ -s "$part" ]; then
    mv -f "$part" "$out"
    trim_cache
    printf '%s\n' "$out"
    return 0
  fi
  rm -f "$part"
  return 1
}

# 验证码那种多句播报：先并行合成，念的时候就不用一句一等
prewarm() {
  [ "$ENGINE" = "deepseek" ] && has_key && can_cloud || return 0
  local t
  for t in "$@"; do synth_file "$t" >/dev/null 2>&1 & done
  wait
}

# 当前阶段写进 status 文件（synth = 正在生成，play = 正在播放），设置页据此显示动效
phase() { printf '%s' "$1" > "$STATE/status" 2>/dev/null; }
# 这次播报的结果（ok / fallback = 云端失败改用本地 / fail = 没念出来），设置页播完后显示
outcome() {
  # fail 不被后面的 ok 覆盖；fallback 只覆盖 ok
  local cur; cur=$(cat "$STATE/result" 2>/dev/null)
  case "$cur:$1" in fail:*|fallback:ok) return 0 ;; esac
  printf '%s' "$1" > "$STATE/result" 2>/dev/null
}

# 先用 DeepSeek TTS 生成 WAV 再 afplay；任何一步失败都退回 macOS say
speak() {
  local text="$1" rate="${2:-$RATE}" pid st=0 out
  if [ "$ENGINE" = "deepseek" ] && has_key && can_cloud; then
    phase synth
    out=$(synth_file "$text" 2>/dev/null)
    if [ -n "$out" ] && [ -s "$out" ]; then
      phase play
      afplay "$out" 2>/dev/null &
      pid=$!
      echo "$pid" > "$STATE/say.pid" 2>/dev/null
      wait "$pid" 2>/dev/null; st=$?
      rm -f "$STATE/say.pid" 2>/dev/null
      # 被 stop 掐掉也是非 0，那种不算失败
      if [ "$st" -ne 0 ] && [ -f "$STATE/status" ]; then outcome fail; else outcome ok; fi
      return 0
    fi
    log "CLOUD-FAIL	$text"
  fi
  [ "$ENGINE" = "deepseek" ] && outcome fallback
  phase play
  if [ -n "$VOICE" ]; then
    say -v "$VOICE" -r "$rate" -- "$text" 2>/dev/null &
  else
    say -r "$rate" -- "$text" 2>/dev/null &
  fi
  pid=$!
  echo "$pid" > "$STATE/say.pid" 2>/dev/null
  wait "$pid" 2>/dev/null; st=$?
  rm -f "$STATE/say.pid" 2>/dev/null
  # 指定音色念不出来时退回系统默认音色
  if [ "$st" -ne 0 ] && [ -f "$STATE/status" ]; then
    say -r "$rate" -- "$text" 2>/dev/null && outcome ok || outcome fail
  else
    outcome ok
  fi
  return 0
}

digits_cn() {
  if [ "$VLANG" != "zh" ]; then
    sed -e 's/\(.\)/\1, /g' <<< "$1"
  else
    sed -e 's/0/零，/g; s/1/一，/g; s/2/二，/g; s/3/三，/g; s/4/四，/g; s/5/五，/g; s/6/六，/g; s/7/七，/g; s/8/八，/g; s/9/九，/g' <<< "$1"
  fi
}

payload() {
  case "$STYLE" in
    code)
      local cn; cn=$(digits_cn "$TEXT")
      prewarm "$(lead)$(m need_code)" "$(m code_is)$cn" "$(m again)$cn" "$(m send_code)"
      if [ "$NO_CHIME" = "0" ]; then chime "Sosumi"; sleep 0.25; chime "Sosumi"; sleep 0.3; fi
      speak "$(lead)$(m need_code)" 180
      speak "$(m code_is)$cn" 135
      sleep 0.7
      speak "$(m again)$cn" 125
      speak "$(m send_code)" 180
      ;;
    done)
      [ "$NO_CHIME" = "1" ] || chime "Glass"
      speak "$(lead)$(m done)$TEXT"
      ;;
    approve)
      [ "$NO_CHIME" = "1" ] || { chime "Frog"; sleep 0.4; }
      speak "$(lead)$(m approve)$TEXT" 190
      ;;
    progress)
      [ "$NO_CHIME" = "1" ] || chime "Tink"
      speak "$(lead)$(m sep)$TEXT"
      ;;
    urgent)
      [ "$NO_CHIME" = "1" ] || { chime "Frog"; sleep 0.4; }
      speak "$(lead)$(m sep)$TEXT" 190
      ;;
    raw) speak "$TEXT" ;;
    *) speak "$(lead)$(m sep)$TEXT" ;;
  esac
}

banner() {
  [ "$NO_BANNER" = "1" ] && return 0
  local title="$(source_label)" what="$(m t_other)"
  case "$STYLE" in
    code) what="$(m t_code)" ;;
    done) what="$(m t_done)" ;;
    approve) what="$(m t_approve)" ;;
    urgent) what="$(m t_urgent)" ;;
  esac
  title="$title · $what"
  local sub=""
  [ -n "$PROJECT" ] && sub="$(proj_label)"
  local esc="$TEXT"
  esc="${esc//\\/\\\\}"; esc="${esc//\"/\\\"}"
  sub="${sub//\\/\\\\}"; sub="${sub//\"/\\\"}"
  osascript -e "display notification \"$esc\" with title \"$title\" subtitle \"$sub\" sound name \"Glass\"" >/dev/null 2>&1
}

STYLE="progress"; TEXT=""; VOICE="$DEFAULT_VOICE"; RATE="${VA_CFG_RATE:-185}"
REPEAT=""; INTERVAL=20; WAIT=0
NO_CHIME=0; [ "${VA_CFG_CHIME:-1}" = "0" ] && NO_CHIME=1
NO_BANNER=0; [ "${VA_CFG_BANNER:-1}" = "0" ] && NO_BANNER=1
KEEP_VOLUME=0; [ "${VA_CFG_AUTO_VOLUME:-1}" = "0" ] && KEEP_VOLUME=1

[ $# -eq 0 ] && { usage; exit 0; }

case "$1" in
  --help|-h|help) usage; exit 0 ;;
  --version|-V) echo "voice-alert $VERSION"; exit 0 ;;
  doctor)
    echo "macOS : $(sw_vers -productVersion 2>/dev/null)  $(uname -m)"
    echo "script: $0"
    echo "engine: $ENGINE    voice: $VOICE_ID  provider: $PROVIDER${BASE_URL:+ ($BASE_URL)} ($(has_key && echo 有 key || echo 没填 key，用本地语音))"
    echo "say   : $(voice_label "$(detect_voice)")（本地兜底）"
    echo "audio : $(osascript -e 'output volume of (get volume settings)' 2>/dev/null) / muted $(osascript -e 'output muted of (get volume settings)' 2>/dev/null)"
    echo "中文音色:"
    say -v '?' 2>/dev/null | grep 'zh_' | sed 's/[[:space:]]*#.*//' | head -6 | sed 's/^/  - /'
    echo "state : $STATE"
    exit 0 ;;
  status)
    echo "engine: $ENGINE / $VOICE_ID"
    echo "say   : $(voice_label "$VOICE")"
    echo "audio : $(osascript -e 'get volume settings' 2>/dev/null)"
    echo "recent:"
    tail -n 5 "$LOG" 2>/dev/null | cut -f2- | sed 's/^/  /'
    if [ -f "$WATCH_FILE" ] && [ "$(cat "$WATCH_FILE")" -gt "$(date +%s)" ]; then
      echo "watch : 开（剩 $(( ($(cat "$WATCH_FILE") - $(date +%s)) / 60 )) 分钟）"
    else echo "watch : 关"; fi
    [ -d "$LOCK" ] && echo "state : 正在播放" || echo "state : 空闲"
    exit 0 ;;
  stop)
    date +%s > "$STOP"
    # 掐掉正在播的那句和还在排队的重复循环，否则 stop 之后还会再念几遍
    if [ -f "$STATE/loop.pid" ]; then
      kill "$(cat "$STATE/loop.pid" 2>/dev/null)" 2>/dev/null
      rm -f "$STATE/loop.pid"
    fi
    # 只掐我们自己的播放进程，别误伤系统里别的 say
    if [ -f "$STATE/say.pid" ]; then
      kill "$(cat "$STATE/say.pid" 2>/dev/null)" 2>/dev/null
      rm -f "$STATE/say.pid"
    fi
    rm -f "$STATE/status"
    echo "$(ts)	STOP" >> "$LOG"
    echo "已停止重复提醒"; exit 0 ;;
  watch)
    case "${2:-show}" in
      off)
        rm -f "$WATCH_FILE"
        echo "待命模式：关"; exit 0 ;;
      on)
        hours="${3:-${VA_CFG_WATCH_HOURS:-4}}"
        exp=$(( $(date +%s) + hours * 3600 ))
        echo "$exp" > "$WATCH_FILE"
        echo "待命模式：开，到 $(date -r "$exp" '+%H:%M') 自动结束"
        exit 0 ;;
    esac
    if [ -f "$WATCH_FILE" ] && [ "$(cat "$WATCH_FILE")" -gt "$(date +%s)" ]; then
      echo "待命模式：开（还剩 $(( ($(cat "$WATCH_FILE") - $(date +%s)) / 60 )) 分钟）"
    else
      echo "待命模式：关"
    fi
    exit 0 ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --style) STYLE="$2"; shift 2 ;;
    --voice) case "$2" in stella|tide) VOICE_ID="$2" ;; *) VOICE="$2" ;; esac; shift 2 ;;
    --engine) ENGINE="$2"; shift 2 ;;
    --rate)  RATE="$2"; shift 2 ;;
    --repeat) REPEAT="$2"; shift 2 ;;
    --interval) INTERVAL="$2"; shift 2 ;;
    --code)  STYLE="code"; TEXT="$2"; shift 2 ;;
    --approve) STYLE="approve"; TEXT="$2"; shift 2 ;;
    --from) SOURCE="$2"; shift 2 ;;
    --project) PROJECT="$2"; shift 2 ;;
    --no-chime) NO_CHIME=1; shift ;;
    --no-banner) NO_BANNER=1; shift ;;
    --keep-volume) KEEP_VOLUME=1; shift ;;
    --wait) WAIT=1; shift ;;
    -*) echo "未知选项: $1" >&2; exit 2 ;;
    *) TEXT="$1"; shift ;;
  esac
done

[ -z "$TEXT" ] && [ "$STYLE" = "approve" ] && TEXT="$(m please_check)"
[ -z "$TEXT" ] && { echo "缺少要播报的内容" >&2; exit 2; }
# 英文播报时不要用中文本地音色兜底，交给系统默认
[ -n "$VOICE" ] || { [ "$VLANG" != "zh" ] || VOICE=$(detect_voice); }

if [ "$STYLE" = "approve" ] && [ "$APPROVAL_ON" = "0" ] && [ "${VA_CFG_APPROVAL_FORCE:-0}" != "1" ]; then
  printf '%s\t%s\tSKIP(批准提醒已关)\n' "$(ts)" "$TEXT" >> "$LOG"
  exit 0
fi

case "$STYLE" in
  code)   [ -z "$REPEAT" ] && REPEAT=2 ;;
  urgent) [ -z "$REPEAT" ] && REPEAT=2 ;;
  *)      [ -z "$REPEAT" ] && REPEAT=1 ;;
esac

# 防叠播：20 秒内已经播过就不再插队（验证码除外）。否则连着几次 urgent
# 会像卡带一样反复念，正是用户抱怨的问题。
if [ "$STYLE" != "code" ] && [ "$STYLE" != "approve" ] && [ "$STYLE" != "raw" ]; then
  _now=$(date +%s); _last=$(cat "$STATE/last_play" 2>/dev/null || echo 0)
  if [ $((_now - _last)) -lt "$DEDUPE" ]; then
    printf '%s\t%s\tSKIP(%s秒内已播报)\n' "$(ts)" "$TEXT" "$DEDUPE" >> "$LOG"
    exit 0
  fi
fi
echo "$(date +%s)" > "$STATE/last_play"

run_once() {
  acquire_lock
  trap 'restore_audio; rm -f "$STATE/status"; release_lock' EXIT
  prepare_audio
  [ "$1" = "1" ] && rm -f "$STATE/result"
  phase synth
  log "$STYLE	[$(source_label)${PROJECT:+/$PROJECT}] $TEXT	($1/$REPEAT)"
  payload
  banner
  restore_audio
  rm -f "$STATE/status"
  trap - EXIT
  release_lock
}

if [ "$WAIT" = "1" ]; then
  n=1
  while [ "$n" -le "$REPEAT" ]; do
    run_once "$n"
    n=$((n+1))
    [ "$n" -le "$REPEAT" ] && sleep "$INTERVAL"
  done
  exit 0
fi

(
  n=1
  while [ "$n" -le "$REPEAT" ]; do
    if [ -f "$STOP" ]; then
      s=$(stat -f %m "$STOP" 2>/dev/null || echo 0)
      [ "$s" -ge "$STARTED" ] && break
    fi
    run_once "$n"
    n=$((n+1))
    [ "$n" -le "$REPEAT" ] && sleep "$INTERVAL"
  done
) >/dev/null 2>&1 &
echo $! > "$STATE/loop.pid" 2>/dev/null
disown 2>/dev/null
exit 0
